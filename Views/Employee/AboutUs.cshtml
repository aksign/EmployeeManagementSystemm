@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">About Us</h2>
        </div>

        <div class="card-body">

            <p>
                Employee Management System is a web-based application developed
                to manage employee information efficiently.
            </p>

            <p>
                This project is developed using
                <strong>ASP.NET Core MVC</strong>,
                <strong>Entity Framework Core</strong>,
                <strong>SQL Server</strong>, and
                <strong>Bootstrap</strong>.
            </p>

            <h5 class="mt-4">Features</h5>

            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item">✔ Add Employee</li>
                <li class="list-group-item">✔ Edit Employee Details</li>
                <li class="list-group-item">✔ Delete Employee</li>
                <li class="list-group-item">✔ Search Employee</li>
                <li class="list-group-item">✔ Manage Departments</li>
            </ul>

            <p>
                The main objective of this project is to simplify employee
                record management and provide an easy-to-use interface.
            </p>

            <p>
                This project is created for educational purposes to demonstrate
                CRUD operations, database connectivity, and responsive web
                design.
            </p>

        </div>

    </div>

</div>