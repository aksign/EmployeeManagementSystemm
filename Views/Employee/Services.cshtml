@{
    ViewData["Title"] = "Services";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">Our Services</h2>
        </div>

        <div class="card-body">

            <p>
                Employee Management System provides a set of services to help
                organizations efficiently manage employee records and related
                information.
            </p>

            <div class="list-group">

                <div class="list-group-item">
                    <h5>Employee Management</h5>
                    <p class="mb-0">
                        Add, edit, delete, and view employee records with ease.
                    </p>
                </div>

                <div class="list-group-item">
                    <h5>Department Management</h5>
                    <p class="mb-0">
                        Organize employees by assigning them to different departments.
                    </p>
                </div>

                <div class="list-group-item">
                    <h5>Employee Search</h5>
                    <p class="mb-0">
                        Quickly search employees by name and access their details.
                    </p>
                </div>

                <div class="list-group-item">
                    <h5>Record Management</h5>
                    <p class="mb-0">
                        Maintain employee information in a well-structured SQL Server database.
                    </p>
                </div>

                <div class="list-group-item">
                    <h5>Secure Data Storage</h5>
                    <p class="mb-0">
                        Store employee data securely using Entity Framework Core and SQL Server.
                    </p>
                </div>

                <div class="list-group-item">
                    <h5>Responsive User Interface</h5>
                    <p class="mb-0">
                        A clean and responsive interface built with Bootstrap for desktop and mobile devices.
                    </p>
                </div>

            </div>

        </div>

    </div>

</div>  
